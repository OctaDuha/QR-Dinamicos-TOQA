# ---------- Supabase ----------
# Panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# ---------- Dominio publico ----------
# URL final del sitio (la que va impresa en las placas NFC).
# Ej: https://qr.toqa.com.ar  -> los QR apuntan a https://qr.toqa.com.ar/r/0001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Red de seguridad de las placas impresas ----------
# A donde mandar a quien escanea cuando no se puede resolver el QR: Supabase
# caido o pausado, o un numero que no esta en la base. Sin esto ve una pagina
# de error. Poné algo util: tu Instagram, o una pagina de "en mantenimiento".
QR_FALLBACK_URL=https://instagram.com/tu.cuenta

# Opcional. Si la definis en Vercel, solo Vercel puede disparar el keepalive
# diario que mantiene despierta la base de Supabase.
CRON_SECRET=

# ---------- Canva Connect API (opcional) ----------
# developers.canva.com > Your integrations
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Plantilla "NFC y QR" publicada como Brand Template (requiere Canva Enterprise)
CANVA_BRAND_TEMPLATE_ID=
