# ---------- Supabase ----------
# Panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# ---------- Dominio publico ----------
# URL final del sitio (la que va impresa en las placas NFC).
# Ej: https://toqaqr.com.ar  -> los QR apuntan a https://toqaqr.com.ar/0001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Red de seguridad de las placas impresas ----------
# A donde mandar a quien escanea cuando no se puede resolver el QR: Supabase
# caido o pausado, o un numero que no esta en la base. Sin esto ve una pagina
# de error. Poné algo util: tu Instagram, o una pagina de "en mantenimiento".
QR_FALLBACK_URL=https://www.instagram.com/toqa.nfc/

# Opcional. Si la definis en Vercel, solo Vercel puede disparar el keepalive
# diario que mantiene despierta la base de Supabase.
CRON_SECRET=

# ---------- Copia de seguridad automatica (opcional) ----------
# La agrega sola Vercel al crear un Blob store desde Storage. Con esto, el
# CSV con la lista de QR se guarda solo cada vez que la lista cambia.
BLOB_READ_WRITE_TOKEN=

# ---------- Canva Connect API (opcional) ----------
# developers.canva.com > Your integrations
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Plantilla "NFC y QR" publicada como Brand Template (requiere Canva Enterprise)
CANVA_BRAND_TEMPLATE_ID=

# ---------- Mail diario con la copia (opcional) ----------
# resend.com > API Keys (permiso "Sending access"). Secret.
RESEND_API_KEY=
# A quien le llega el CSV todos los dias.
RESPALDO_EMAIL=
# Opcional: remitente propio (dominio verificado en Resend) y cada cuantos dias.
RESPALDO_EMAIL_FROM=
RESPALDO_MAIL_DIAS=1

# ---------- Bot de WhatsApp (opcional) ----------
# Meta > tu app > WhatsApp. Token permanente del usuario del sistema. Secret.
WHATSAPP_TOKEN=
# Meta > tu app > Configuracion > Basica > Clave secreta. Secret.
WHATSAPP_APP_SECRET=
# Identificador del numero que usa el bot, y ese numero solo con digitos.
WHATSAPP_PHONE_ID=
WHATSAPP_NUMERO=
# La genera el dueño en Panel > WhatsApp. Secret.
BOT_LLAVE=
# Opcionales: version de la Graph API y, solo para pruebas, otra base.
# WHATSAPP_API_VERSION=v23.0
# WHATSAPP_API_BASE=https://graph.facebook.com

# ---------- Conectar el WhatsApp Business del celular (opcional) ----------
# No son secretos; si faltan se usan los de la app de TOQA.
# NEXT_PUBLIC_META_APP_ID=
# NEXT_PUBLIC_META_CONFIG_ID=
